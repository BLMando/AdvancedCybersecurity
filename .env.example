# ─── Zero Trust Architecture Environment Configuration ──────────────────

# MongoDB
MONGO_ROOT_PASSWORD=
MONGO_ROOT_USERNAME=
MONGO_INITDB_DATABASE=
ZTA_MONGO_CREDENTIALS_JSON='{"mario.rossi": {"user": "mario.rossi", "password": "mario_password_here"}, "anna.verdi": {"user": "anna.verdi", "password": "anna_password_here"}, "giulia.bianchi": {"user": "giulia.bianchi", "password": "giulia_password_here"}, "luca.ferrari": {"user": "luca.ferrari", "password": "luca_password_here"}, "admin": {"user": "admin", "password": "admin_password_here"}}'

# Envoy
ENVOY_ADMIN_PORT=
ENVOY_PROXY_PORT=

# OPA
OPA_API_PORT=
OPA_GRPC_PORT=

# Splunk HEC (create in Splunk Web → HTTP Event Collector, index zta_envoy)
SPLUNK_HEC_TOKEN_ENVOY=

# Splunk management API (forwarder stats + splunk_setup.py)
SPLUNK_PASSWORD=
# Set to true only if Splunk uses a trusted CA (Docker lab: leave false or unset)
SPLUNK_VERIFY_TLS=false

# Logging
LOG_LEVEL=

