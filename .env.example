# ─── Zero Trust Architecture Environment Configuration ──────────────────

# MongoDB
MONGO_ROOT_PASSWORD=
MONGO_ROOT_USERNAME=
MONGO_INITDB_DATABASE=

# Envoy
ENVOY_ADMIN_PORT=
ENVOY_PROXY_PORT=

# OPA
OPA_API_PORT=
OPA_GRPC_PORT=

# Splunk HEC (create in Splunk Web → HTTP Event Collector, index zta_envoy)
SPLUNK_HEC_TOKEN_ENVOY=

# Splunk management API (forwarder stats + splunk_setup.py)
SPLUNK_PASSWORD=
# Set to true only if Splunk uses a trusted CA (Docker lab: leave false or unset)
SPLUNK_VERIFY_TLS=false

# Logging
LOG_LEVEL=

