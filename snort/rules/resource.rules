# Snort 3 — Regole Sonda MongoDB

# ── Accesso diretto MongoDB (Bypass del PEP) ──
alert tcp !172.19.0.100 any -> any 27017 (
    msg:"Direct MongoDB access attempt - PEP bypass";
    classtype:policy-violation;
    sid:4000001; rev:8;
)

# ── Connection Flood su MongoDB ──
alert tcp any any -> any 27017 (
    msg:"MongoDB TCP connection flood - possible resource exhaustion";
    flags: S;
    detection_filter: track by_src, count 15, seconds 5;
    classtype:denial-of-service;
    sid:4000002; rev:7;
)
