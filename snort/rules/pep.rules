# Snort 3 — Regole Sonda PEP (Envoy sidecar)
# Posizione: namespace di rete condiviso con Envoy
# Vede: traffico post-firewall, pre-autorizzazione

# ── NoSQL Injection: $where ──
# Tentativo di injection nel traffico MongoDB via Envoy
alert tcp any any -> any 10000 ( \
    msg:"NoSQL injection attempt ($where) in MongoDB traffic"; \
    flow:to_server,established; \
    content:"$where",nocase; \
    classtype:web-application-attack; \
    sid:3000001; rev:1; \
)

# ── NoSQL Injection: $function ──
alert tcp any any -> any 10000 ( \
    msg:"NoSQL injection attempt ($function) in MongoDB traffic"; \
    flow:to_server,established; \
    content:"$function",nocase; \
    classtype:web-application-attack; \
    sid:3000002; rev:1; \
)

# ── NoSQL Injection: $regex (ReDoS) ──
alert tcp any any -> any 10000 ( \
    msg:"NoSQL injection attempt ($regex) - possible ReDoS"; \
    flow:to_server,established; \
    content:"$regex",nocase; \
    classtype:web-application-attack; \
    sid:3000003; rev:1; \
)

# ── Lateral Movement: scansione est-ovest tra container ──
alert tcp any any -> any any ( \
    msg:"Internal lateral movement detected (east-west scan)"; \
    flags:S; \
    detection_filter: track by_src, count 50, seconds 30; \
    classtype:attempted-recon; \
    sid:3000004; rev:1; \
)

# ── Envoy Admin access da rete non-localhost ──
alert tcp any any -> any 9901 ( \
    msg:"Envoy admin access attempt"; \
    flow:to_server,established; \
    classtype:policy-violation; \
    sid:3000005; rev:1; \
)

# ── Port scan verso Envoy ──
alert tcp any any -> any any ( \
    msg:"TCP SYN port scan targeting PEP"; \
    flags:S; \
    detection_filter: track by_src, count 20, seconds 5; \
    classtype:attempted-recon; \
    sid:3000006; rev:1; \
)

# ── ICMP verso Envoy (possibile tunneling) ──
alert icmp any any -> any any ( \
    msg:"Suspicious ICMP large payload (possible exfiltration via PEP)"; \
    dsize:>100; \
    itype:8; \
    classtype:misc-activity; \
    sid:3000007; rev:1; \
)
