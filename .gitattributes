# Normalize LF for all text files
* text=auto

# PEM certificate files must always use LF
*.crt text eol=lf
*.key text eol=lf
*.pem text eol=lf

# Shell scripts
*.sh text eol=lf

# Markdown, code
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.rego text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
